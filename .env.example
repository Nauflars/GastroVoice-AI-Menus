APP_ENV=dev
APP_SECRET=change_this_to_a_secure_random_string_32chars

# PostgreSQL
POSTGRES_DB=gastrovoice
POSTGRES_USER=gastrovoice
POSTGRES_PASSWORD=change_this_password

# JWT
JWT_PASSPHRASE=change_this_passphrase

# OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# OpenAI Models (cost-optimized defaults — override to upgrade/downgrade)
OPENAI_MENU_MODEL=gpt-4.1           # Vision model for menu image extraction
OPENAI_INTENT_MODEL=gpt-4.1-mini    # Text model for intent detection (bot)
OPENAI_REALTIME_MODEL=gpt-realtime-2  # Realtime voice model
OPENAI_TTS_MODEL=tts-1              # Text-to-speech model
OPENAI_TTS_VOICE=alloy              # TTS voice (alloy|echo|fable|onyx|nova|shimmer)

# Telephony (used with --profile telephony)
RESTAURANT_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890
RESTAURANT_NAME=Mi Restaurante

# Frontend
VITE_API_URL=http://localhost:8080
