<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\RestaurantManagement\Domain\Entity\Restaurant" table="restaurants">
        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="name" type="string" length="255" nullable="false"/>
        <field name="address" type="text" nullable="false"/>
        <field name="phone" type="string" length="50" nullable="false"/>
        <field name="timezone" type="string" length="100" nullable="false"/>
        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="false"/>
        <embedded name="seatCapacity" class="App\RestaurantManagement\Domain\ValueObject\SeatCapacity" column-prefix="seat_"/>
        <embedded name="slotDuration" class="App\RestaurantManagement\Domain\ValueObject\SlotDuration" column-prefix="slot_"/>
        <one-to-many field="openingHours" target-entity="App\RestaurantManagement\Domain\Entity\OpeningHour" mapped-by="restaurantId">
            <cascade>
                <cascade-all/>
            </cascade>
        </one-to-many>
    </entity>

    <entity name="App\RestaurantManagement\Domain\Entity\OpeningHour" table="opening_hours">
        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="restaurantId" type="uuid" column="restaurant_id" nullable="false"/>
        <field name="dayOfWeek" type="smallint" column="day_of_week" nullable="false"/>
        <field name="openTime" type="string" length="5" column="open_time" nullable="true"/>
        <field name="closeTime" type="string" length="5" column="close_time" nullable="true"/>
        <field name="isClosed" type="boolean" column="is_closed" nullable="false"/>
    </entity>
</doctrine-mapping>
