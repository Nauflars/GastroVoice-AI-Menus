<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Ordering\Domain\Entity\Order" table="orders">
        <id name="id" type="uuid" column="id"/>
        <field name="restaurantId" type="uuid" column="restaurant_id" nullable="false"/>
        <field name="statusValue" type="string" column="status" length="20" nullable="false"/>
        <field name="sourceValue" type="string" column="source" length="20" nullable="false"/>
        <field name="tableNumber" type="string" column="table_number" length="50" nullable="true"/>
        <field name="customerPhone" type="string" column="customer_phone" length="50" nullable="true"/>
        <field name="notes" type="text" column="notes" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="false"/>
    </entity>

    <entity name="App\Ordering\Domain\Entity\OrderLine" table="order_lines">
        <id name="id" type="uuid" column="id"/>
        <field name="orderId" type="uuid" column="order_id" nullable="false"/>
        <field name="menuItemId" type="uuid" column="menu_item_id" nullable="false"/>
        <field name="menuItemName" type="string" column="menu_item_name" length="255" nullable="false"/>
        <field name="quantity" type="integer" column="quantity" nullable="false"/>
        <field name="unitPrice" type="float" column="unit_price" nullable="false"/>
        <field name="currency" type="string" column="currency" length="3" nullable="false"/>
    </entity>

</doctrine-mapping>
